DEEPSEEK_API_KEY=replace-with-your-key
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# DeepSeek model used when a conversation includes images. Override when your account exposes a different vision model.
DEEPSEEK_VISION_API_KEY=
DEEPSEEK_VISION_API_BASE=
DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp
# DeepSeek Responses API native web search. Search requests use this model when the provider is api.deepseek.com.
DEEPSEEK_NATIVE_SEARCH_MODEL=deepseek-v4-flash
DEEPSEEK_NATIVE_SEARCH=true
DEEPSEEK_NATIVE_SEARCH_MAX_TOKENS=1024
# Upload inline images to DeepSeek Files API when using the native DeepSeek provider.
# Failed uploads automatically fall back to inline image_url content.
DEEPSEEK_FILES_API=true
# Optional server-side candidate pool for step-level model routing. Values are
# model names accepted by the configured text Provider; explicit task models win.
AXIOM_ALLOWED_MODELS=deepseek-chat,deepseek-v4-flash,deepseek-v4-pro
# Optional JSON cost hints used only for routing scores, for example:
# {"deepseek-chat":{"inputCostPer1kUsd":0.0001,"outputCostPer1kUsd":0.0002}}
AXIOM_MODEL_COSTS=
# Optional JSON map values may also include kinds and roles for routing affinity:
# {"deepseek-chat":{"inputCostPer1kUsd":0.0001,"outputCostPer1kUsd":0.0002,"kinds":["conversation","question"],"roles":["analyst"]}}

# Runtime process
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=8787
LOG_LEVEL=info
# Calendar-day aggregation for timelines and usage charts.
AXIOM_TIME_ZONE=Asia/Shanghai
# Conservative model-context token budget. Providers can override the default
# estimate in code with an exact tokenizer when one is available.
AXIOM_CONTEXT_MAX_TOKENS=12000

# Local development uses SQLite. Production should set DATABASE_URL.
DATABASE_URL=
DATABASE_SSL=false
DATABASE_POOL_SIZE=10
AXIOM_SQLITE_PATH=.data/axiom-control-room.sqlite
ALLOW_SQLITE_PRODUCTION=false

# Local Docker PostgreSQL example. Replace credentials in shared environments.
# DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/axiom

# Production authentication must be enforced here or by a trusted reverse proxy.
AXIOM_API_KEY=
AXIOM_TRUST_PROXY_AUTH=false
# Development Vite uses 4300; the production single-service build uses 8787.
# Replace these loopback values with the real HTTPS console origin in production.
AXIOM_ALLOWED_ORIGINS=http://127.0.0.1:4300,http://localhost:4300,http://127.0.0.1:8787,http://localhost:8787
AXIOM_PRINCIPAL_SECRET=
# Required to enable server-side encrypted custom Provider credentials.
# Use a long random value and keep it identical across all workers.
AXIOM_PROVIDER_SECRET=
# Encrypts outbound Webhook URLs and signing secrets. Keep this value identical
# across every worker. Falls back to AXIOM_PROVIDER_SECRET when left empty.
AXIOM_NOTIFICATION_SECRET=
# Delivered/dead-letter audit retention, clamped to 1-365 days.
AXIOM_NOTIFICATION_RETENTION_DAYS=90
# Optional HMAC key for plugin release evidence. Use at least 32 characters and
# keep it identical across all workers. Signed plugins fail closed without it.
AXIOM_PLUGIN_SIGNING_KEY=
# Enable only after AXIOM_PLUGIN_SIGNING_KEY is configured. Legacy unsigned plugins
# then need to be checked and republished before they can run.
AXIOM_REQUIRE_PLUGIN_SIGNATURE=false

# Durable workflow controls
AGENT_TASK_CONCURRENCY=2
# Runtime automatically uses up to this many dependency-ready steps in parallel.
AGENT_STEP_CONCURRENCY=6
# Reasoning-heavy models use a smaller adaptive wave to reduce provider rate
# limits; ordinary models still use AGENT_STEP_CONCURRENCY.
AGENT_REASONING_STEP_CONCURRENCY=3
AGENT_REASONING_STEP_TIMEOUT_MS=300000
AGENT_STEP_MAX_ATTEMPTS=2
AGENT_TASK_LEASE_MS=90000
AGENT_TASK_TIMEOUT_MS=900000
AGENT_MODEL_TIMEOUT_MS=120000
# Reasoning-heavy models such as deepseek-v4-pro receive a longer bounded
# window unless a client explicitly provides its own timeout.
AGENT_REASONING_MODEL_TIMEOUT_MS=300000
AGENT_MODEL_MAX_ATTEMPTS=3
# Large step results are stored as Artifacts. Downstream Agents receive a
# preview plus result_ref; review/synthesis may dereference within a budget.
AGENT_STEP_RESULT_ARTIFACT_THRESHOLD=12000
AGENT_STEP_RESULT_PREVIEW_CHARS=4000
# Final synthesis output ceiling and the maximum number of bounded continuation
# calls when a provider returns finish_reason=length.
AGENT_SYNTHESIS_MAX_TOKENS=8192
AGENT_SYNTHESIS_MAX_CONTINUATIONS=4
AGENT_REVIEW_CORRECTION_ROUNDS=1
AGENT_REQUIRE_REVIEW_APPROVAL=true
AGENT_REVIEW_MIN_SCORE=80

# Optional TencentDB Agent Memory / MemoryCore gateway
TDAI_MEMORY_ENDPOINT=
TDAI_MEMORY_API_KEY=
TDAI_MEMORY_INSTANCE_ID=axiom-control-room
AXIOM_MEMORY_MIN_CONFIDENCE=0.25
AXIOM_MEMORY_L1_BUDGET=6000
AXIOM_MEMORY_L2_BUDGET=2500
AXIOM_MEMORY_L3_BUDGET=3500

# Reserved sidecar boundary. The built-in orchestrator remains active until a
# compatible Harness adapter is explicitly deployed and selected.
DEEPSEEK_HARNESS_URL=
DEEPSEEK_HARNESS_API_KEY=
# ACP JSON-RPC stdio sidecar. Prefer the JSON array form so no shell is ever
# involved, for example ["node","C:/path/to/acp-server.mjs"].
DEEPSEEK_HARNESS_COMMAND_JSON=
DEEPSEEK_HARNESS_COMMAND=
DEEPSEEK_HARNESS_CWD=
DEEPSEEK_HARNESS_TIMEOUT_MS=30000
DEEPSEEK_HARNESS_ACTIVE=false
# Codex app-server v2 stdio sidecar. Point the command at a pinned native
# executable in production instead of relying on a mutable PATH entry.
CODEX_APP_SERVER_COMMAND_JSON=
CODEX_APP_SERVER_COMMAND=
CODEX_APP_SERVER_CWD=
CODEX_APP_SERVER_TIMEOUT_MS=30000
CODEX_APP_SERVER_ACTIVE=false

# Production readiness controls. The readiness endpoint reports a blocker when
# tool calls are not isolated by a sandbox profile.
AXIOM_TOOL_EXECUTOR=disabled
AXIOM_TOOL_SANDBOX_IMAGE=ubuntu:22.04
AXIOM_TOOL_ALLOWED_COMMANDS=node,npm,git,rg,cat,python3
AXIOM_TOOL_MAX_OUTPUT_BYTES=1000000
# Optional read-only adapters. HTTP/browser stay disabled unless hosts are listed.
AXIOM_READONLY_DATABASE_URL=
AXIOM_HTTP_ALLOWLIST=
# S3-compatible Artifact storage. Use s3://bucket/prefix for AWS defaults,
# or http(s)://host[:port]/bucket/prefix for MinIO/COS path-style endpoints.
AXIOM_OBJECT_STORAGE_ENDPOINT=
AXIOM_OBJECT_STORAGE_BUCKET=
AXIOM_OBJECT_STORAGE_REGION=us-east-1
AXIOM_OBJECT_STORAGE_PREFIX=axiom-artifacts
AXIOM_OBJECT_STORAGE_ACCESS_KEY=
AXIOM_OBJECT_STORAGE_SECRET_KEY=
AXIOM_OBJECT_STORAGE_SESSION_TOKEN=
AXIOM_OBJECT_STORAGE_FORCE_PATH_STYLE=
AXIOM_OBJECT_STORAGE_SSE=
AXIOM_OBJECT_STORAGE_TIMEOUT_MS=12000
AXIOM_OBJECT_STORAGE_PATH=.data/artifacts
OTEL_EXPORTER_OTLP_ENDPOINT=
PROMETHEUS_ENABLED=false
# Runtime alert thresholds. Alerts are derived from durable task/event data;
# set these per environment instead of relying on UI-only guesses.
AXIOM_ALERT_QUEUED_TASKS=10
AXIOM_ALERT_QUEUED_TASKS_CRITICAL=50
AXIOM_ALERT_OLDEST_QUEUE_WAIT_MS=300000
AXIOM_ALERT_OLDEST_QUEUE_WAIT_CRITICAL_MS=900000
AXIOM_ALERT_TOOL_FAILURE_RATE=25
AGENT_INPUT_COST_PER_1K_USD=0
AGENT_OUTPUT_COST_PER_1K_USD=0
# Optional discounted input price for Provider-reported prompt cache hits.
AGENT_CACHE_HIT_INPUT_COST_PER_1K_USD=0
AXIOM_WEBHOOK_SECRET=
# Signed webhook requests must include a Unix timestamp, v1 HMAC signature and
# an Idempotency-Key. The replay window is clamped to 30-3600 seconds.
AXIOM_WEBHOOK_TOLERANCE_SECONDS=300
AXIOM_SCHEDULER_ENABLED=true
AXIOM_SCHEDULER_QUEUE_URL=

# Optional server-side default for the image generation/editing adapter.
# The UI can also receive a per-request provider override; these values are never returned with the key.
DMX_API_KEY=replace-with-your-image-key
DMX_BASE_URL=https://www.dmxapi.cn
DMX_MODEL=gpt-image-2-03
# Optional: load DMX_API_KEY/DMX_BASE_URL/DMX_MODEL from the referenced image skill config.
DMX_CONFIG_PATH=

# Optional local video generation service. API key may be empty for a trusted local server.
# VIDEO_API_BASE may be a service root or a complete video-generation endpoint.
VIDEO_API_BASE=
VIDEO_API_KEY=
VIDEO_MODEL=
