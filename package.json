{
  "name": "agent-control-room",
  "version": "2.3.0-rc.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx server/index.ts --api-only",
    "dev:web": "vite",
    "build": "tsc -b && tsc -p server/tsconfig.json && node scripts/copy-server-assets.mjs && vite build",
    "start": "node server-dist/index.js",
    "db:migrate": "node server-dist/migrate.js",
    "db:migrate:dev": "tsx server/migrate.ts",
    "check": "tsc -b && tsc -p server/tsconfig.json --noEmit",
    "test": "tsx --test server/runtime/*.test.ts src/lib/*.test.ts",
    "qa:runtime": "node scripts/runtime-smoke.mjs",
    "qa:report-export": "tsx scripts/report-export-smoke.ts",
    "qa:visual": "node scripts/visual-qa.mjs",
    "qa:i18n": "node qa/ui-language-smoke.mjs",
    "qa:agentgraph3d": "node qa/agentgraph-3d-smoke.mjs",
    "qa:object-storage": "node --import tsx qa/object-storage-integration.mjs",
    "qa:object-storage:local": "node scripts/local-object-storage-acceptance.mjs",
    "qa:chat": "node qa/chat-gateway-smoke.mjs",
    "qa:direct-stream": "node qa/direct-stream-retry-smoke.mjs",
    "qa:search-agent": "node qa/search-agent-smoke.mjs",
    "qa:session-routing": "node qa/session-routing-regression.mjs",
    "qa:session-persistence": "node qa/session-persistence-regression.mjs",
    "qa:context-summary": "node qa/context-summary-regression.mjs",
    "qa:task-delete": "node qa/task-delete-regression.mjs",
    "qa:human-review": "node qa/human-review-controls-smoke.mjs",
    "qa:live-guidance": "node qa/live-guidance-controls-smoke.mjs",
    "qa:checkpoint": "node qa/checkpoint-controls-smoke.mjs",
    "qa:review-delivery": "node qa/review-delivery-result-regression.mjs",
    "qa:operations": "node qa/operations-console-smoke.mjs",
    "qa:workflow": "node qa/workflow-studio-smoke.mjs",
    "qa:workflow-history": "node qa/workflow-history-regression.mjs",
    "qa:nexus-session": "node qa/nexus-conversation-list-regression.mjs",
    "qa:data-isolation": "node qa/data-isolation-regression.mjs",
    "qa:routing": "node scripts/routing-eval.mjs",
    "qa:business": "node scripts/business-eval.mjs",
    "qa:mcp-business": "node qa/mcp-business-eval.mjs",
    "qa:governance": "tsx --test server/runtime/enterpriseGovernance.test.ts",
    "qa:business-postgres": "node --import tsx --test server/runtime/businessCapabilityStore.postgres.test.ts",
    "qa:postgres-failover": "node --import tsx qa/postgres-multi-worker-failover.mjs",
    "qa:postgres:local": "node scripts/local-postgres-acceptance.mjs",
    "qa:all:local": "node scripts/local-postgres-acceptance.mjs --production-gate",
    "qa:harness-live": "node scripts/harness-sidecar-probe.mjs",
    "qa:memorycore": "node qa/memorycore-integration.mjs",
    "qa:memorycore-adapter": "node --import tsx qa/memorycore-adapter-smoke.mjs",
    "qa:all": "node qa/production-gate.mjs",
    "perf:smoke": "node scripts/performance-smoke.mjs",
    "principal:sign": "node scripts/sign-principal.mjs",
    "cleanup:qa-artifacts": "node scripts/cleanup-local-qa-artifacts.mjs",
    "release:package": "npm run build && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-release.ps1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@hono/node-server": "^1.19.5",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.0",
    "@react-three/postprocessing": "^3.0.4",
    "docx": "^9.7.1",
    "dotenv": "^17.2.3",
    "gsap": "^3.13.0",
    "hono": "^4.10.4",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.12.1",
    "morphicons": "^1.7.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "postprocessing": "^6.38.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.182.0",
    "word-extractor": "^1.0.4",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "pngjs": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
